<% content_for :title, "The Shattered Reach" %>
<main class="landing">
  <section class="hero">
    <div class="hero-art" style="background-image: linear-gradient(90deg, rgba(5,7,20,.84) 0%, rgba(5,7,20,.32) 75%), url('<%= asset_path("shattered_reach/key-art.png") %>')"></div>
    <div class="hero-copy">
      <p class="eyebrow">A tactical space-combat prototype</p>
      <h1>THE <em>SHATTERED</em> REACH</h1>
      <p class="lede">Commit power in secret. Read the impulse. Break the enemy fleet before it breaks you.</p>
      <%= form_with url: matches_path, class: "launch-form", data: { turbo: false } do |form| %>
        <%= form.label :board_size, "Battlefield size" %>
        <%= form.select :board_size, [["12 × 12", 12], ["15 × 15", 15], ["20 × 20", 20]], selected: 15 %>
        <div class="launch-actions">
          <%= form.button "Begin a skirmish", name: :mode, value: :hotseat, class: "primary" %>
          <%= form.button "Fight the command AI", name: :mode, value: :solo, class: "secondary" %>
          <%= form.button "Play the guided tutorial", name: :mode, value: :tutorial, class: "secondary" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="fleet-intro">
    <div><p class="eyebrow">Three powers. One frontier.</p><h2>Choose your doctrine.</h2></div>
    <article class="fleet-card aurelian" style="background-image: linear-gradient(0deg, rgba(11,16,39,.96), rgba(11,16,39,.1)), url('<%= asset_path("shattered_reach/aurelian-lineup.png") %>')"><h3>Aurelian Compact</h3><p>Elegant beam craft and composed formation fighting.</p></article>
    <article class="fleet-card veyr" style="background-image: linear-gradient(0deg, rgba(11,16,39,.96), rgba(11,16,39,.1)), url('<%= asset_path("shattered_reach/veyr-lineup.png") %>')"><h3>Veyr Dominion</h3><p>Relentless mass drivers and long-reaching missiles.</p></article>
    <article class="fleet-card kestrel" style="background-image: linear-gradient(0deg, rgba(11,16,39,.96), rgba(11,16,39,.1)), url('<%= asset_path("shattered_reach/kestrel-lineup.png") %>')"><h3>Kestrel Freeholds</h3><p>Hardy industrial warships with flexible loadouts.</p></article>
  </section>

  <% if @matches.any? %><section class="resume"><p class="eyebrow">Local command archive</p><h2>Resume a battle</h2><div class="resume-list"><% @matches.each do |match| %><%= link_to match, class: "resume-match" do %><span><%= match.title %></span><small>Turn <%= match.state["turn"] %> · <%= match.updated_at.strftime("%b %-d, %H:%M") %></small><% end %><% end %></div></section><% end %>
</main>
