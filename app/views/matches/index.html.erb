<% content_for :title, "The Shattered Reach" %>
<% ship_options = ShatteredReach::GameDefinition::SHIPS.map { |key, ship| ["#{ShatteredReach::GameDefinition::FLEETS.fetch(ship[:fleet])[:name]} · #{ship[:name].delete_prefix("#{ShatteredReach::GameDefinition::FLEETS.fetch(ship[:fleet])[:name].split.first} ")} · #{ship[:size].capitalize}", key] } %>
<% optional_ship_options = [["No ship", ""]] + ship_options %>
<% ship_turn_modes = { "small" => [0, 1, 2], "medium" => [1, 2, 3], "large" => [2, 3, 4] } %>
<main class="landing" data-landing>
  <% if notice.present? || alert.present? %><div class="flash-message <%= alert.present? ? "error" : "success" %>" role="status"><%= alert || notice %></div><% end %>
  <section class="hero">
    <div class="hero-art" style="background-image: linear-gradient(90deg, rgba(5,7,20,.84) 0%, rgba(5,7,20,.32) 75%), url('<%= asset_path("shattered_reach/key-art.png") %>')"></div>
    <div class="hero-copy">
      <p class="eyebrow">A tactical space-combat prototype</p>
      <h1>THE <em>SHATTERED</em> REACH</h1>
      <p class="lede">Commit power in secret. Read the impulse. Break the enemy fleet before it breaks you.</p>
      <div class="launch-actions landing-actions">
        <button type="button" class="primary" data-open-dialog="new-game-dialog">New game</button>
        <button type="button" class="secondary" data-open-dialog="load-game-dialog">Load game</button>
        <button type="button" class="secondary" data-open-dialog="ship-catalog-dialog">View ships</button>
        <%= link_to "Print ship cards", "/the-shattered-reach-ship-cards.pdf", class: "button secondary", target: "_blank", rel: "noopener" %>
      </div>
    </div>
  </section>

  <dialog id="new-game-dialog" class="game-dialog setup-dialog" aria-labelledby="new-game-title" data-game-setup>
    <div class="dialog-frame">
      <button type="button" class="dialog-close" aria-label="Close new game setup" data-close-dialog>×</button>
      <%= form_with url: matches_path, class: "launch-form", data: { turbo: false } do |form| %>
        <header class="dialog-heading">
          <p class="eyebrow">New game · Step <span data-step-number>1</span> of 2</p>
          <h2 id="new-game-title" data-step-heading>Choose your battle</h2>
          <p data-step-description>Select a command mode and the dimensions of the battlefield.</p>
        </header>

        <section class="setup-step" data-setup-step="1">
          <fieldset class="setup-fieldset">
            <legend>Battle type</legend>
            <div class="battle-type-grid">
              <label class="setup-choice">
                <input type="radio" name="mode" value="hotseat" checked>
                <span><strong>Hot-seat skirmish</strong><small>Two commanders share this screen and conceal their allocations.</small></span>
              </label>
              <label class="setup-choice">
                <input type="radio" name="mode" value="solo">
                <span><strong>Fight the command AI</strong><small>Lead your fleet against an automatically balanced enemy force.</small></span>
              </label>
              <label class="setup-choice">
                <input type="radio" name="mode" value="tutorial">
                <span><strong>Guided tutorial</strong><small>Learn energy, movement, weapons, shields, and damage in First Light.</small></span>
              </label>
            </div>
          </fieldset>

          <fieldset class="setup-fieldset">
            <legend>Battlefield size</legend>
            <div class="map-size-grid">
              <% [[12, "Close quarters"], [15, "Standard engagement"], [20, "Deep-space maneuver"]].each do |size, description| %>
                <label class="map-size-choice">
                  <%= form.radio_button :board_size, size, checked: size == 15 %>
                  <span><strong><%= size %> × <%= size %></strong><small><%= description %></small></span>
                </label>
              <% end %>
            </div>
          </fieldset>

          <details class="setup-options-menu">
            <summary><span>Optional rules</span><small>Customize movement and repairs</small></summary>
            <fieldset class="setup-fieldset optional-rules-grid">
              <legend>Battle options</legend>
              <label class="setup-option-toggle">
                <%= check_box_tag "rules_options[acceleration_limits]", "1", false %>
                <span><strong>Acceleration limits</strong><small>Speed may change by at most 5, 4, or 3 for small, medium, or large ships after turn one.</small></span>
              </label>
              <label class="setup-option-toggle">
                <%= check_box_tag "rules_options[weapon_repair]", "1", false %>
                <span><strong>Weapon repair</strong><small>Spend 3 energy to repair one beam or mass driver; it remains offline for that turn.</small></span>
              </label>
              <label class="setup-option-toggle">
                <%= check_box_tag "rules_options[fast_turns]", "1", false %>
                <span><strong>Fast turns</strong><small>A turn rotates the ship 60° and immediately moves it one hex forward.</small></span>
              </label>
            </fieldset>
          </details>

          <footer class="dialog-actions">
            <button type="button" class="primary" data-next-setup>Continue to fleet selection</button>
          </footer>
        </section>

        <section class="setup-step" data-setup-step="2" hidden>
          <div data-custom-deployment>
            <fieldset class="setup-fieldset fleet-builder player-one" data-player-fleet>
              <legend>Your fleet · one to three ships</legend>
              <%= select_tag "player_one_ships[]", options_for_select(ship_options, "aurelian_cruiser"), aria: { label: "Your first ship" } %>
              <%= select_tag "player_one_ships[]", options_for_select(optional_ship_options), aria: { label: "Your second ship" } %>
              <%= select_tag "player_one_ships[]", options_for_select(optional_ship_options), aria: { label: "Your third ship" } %>
            </fieldset>

            <fieldset class="setup-fieldset fleet-builder player-two" data-hotseat-options>
              <legend>Opponent fleet · one to three ships</legend>
              <%= select_tag "player_two_ships[]", options_for_select(ship_options, "kestrel_cruiser"), aria: { label: "Opponent first ship" } %>
              <%= select_tag "player_two_ships[]", options_for_select(optional_ship_options), aria: { label: "Opponent second ship" } %>
              <%= select_tag "player_two_ships[]", options_for_select(optional_ship_options), aria: { label: "Opponent third ship" } %>
            </fieldset>

            <fieldset class="setup-fieldset ai-balance-options" data-ai-options hidden>
              <legend>Command AI balancing</legend>
              <label class="setup-choice compact">
                <%= form.radio_button :ai_match, "size", checked: true, disabled: true %>
                <span><strong>Match fleet strength</strong><small>The AI fields ships with the same total size value.</small></span>
              </label>
              <label class="setup-choice compact">
                <%= form.radio_button :ai_match, "number", disabled: true %>
                <span><strong>Match ship count</strong><small>The AI fields the same number of ships, regardless of class.</small></span>
              </label>
            </fieldset>
          </div>

          <div class="tutorial-deployment" data-tutorial-options hidden>
            <p class="eyebrow">Fixed training deployment</p>
            <h3>First Light</h3>
            <p>The tutorial supplies a pair of frigates and reveals one system at a time. Your battlefield-size selection still applies.</p>
          </div>

          <footer class="dialog-actions split-actions">
            <button type="button" class="secondary" data-previous-setup>Back</button>
            <%= form.submit "Begin skirmish", class: "primary", data: { begin_game: true } %>
          </footer>
        </section>
      <% end %>
    </div>
  </dialog>

  <dialog id="load-game-dialog" class="game-dialog load-dialog" aria-labelledby="load-game-title">
    <div class="dialog-frame">
      <button type="button" class="dialog-close" aria-label="Close load game" data-close-dialog>×</button>
      <header class="dialog-heading">
        <p class="eyebrow">Local command archive</p>
        <h2 id="load-game-title">Load game</h2>
        <p>Open a downloaded save file or resume a battle stored in this browser.</p>
      </header>
      <%= form_with url: import_matches_path, multipart: true, class: "load-game-form", data: { turbo: false } do |form| %>
        <%= form.label :save_file, "Saved-game file" %>
        <%= form.file_field :save_file, accept: ".json,application/json", required: true %>
        <%= form.submit "Load file", class: "secondary" %>
      <% end %>
      <% if @matches.any? %>
        <div class="resume-list">
          <% @matches.each do |match| %>
            <%= link_to match, class: "resume-match" do %>
              <span><%= match.title %></span>
              <small>Turn <%= match.state["turn"] %> · <%= match.updated_at.strftime("%b %-d, %H:%M") %></small>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="archive-empty">No local battles are waiting to be resumed.</p>
      <% end %>
    </div>
  </dialog>

  <dialog id="ship-catalog-dialog" class="game-dialog ship-catalog-dialog" aria-labelledby="ship-catalog-title" data-ship-catalog>
    <div class="dialog-frame ship-catalog-frame">
      <button type="button" class="dialog-close" aria-label="Close ship gallery" data-close-dialog>×</button>
      <header class="dialog-heading ship-catalog-heading">
        <p class="eyebrow">Fleet recognition archive</p>
        <h2 id="ship-catalog-title">Ships of the Reach</h2>
        <p>Select a vessel to inspect its tactical profile, weapons, and combat systems.</p>
      </header>

      <div class="ship-catalog-layout">
        <nav class="ship-catalog-list" aria-label="Ship classes" role="tablist" aria-orientation="vertical">
          <% ShatteredReach::GameDefinition::FLEETS.each do |fleet_key, fleet| %>
            <section class="catalog-fleet-group fleet-<%= fleet_key %>">
              <h3><%= fleet[:name] %></h3>
              <% ShatteredReach::GameDefinition::SHIPS.select { |_key, ship| ship[:fleet] == fleet_key }.each do |key, ship| %>
                <button type="button"
                        class="catalog-ship-choice<%= " selected" if key == "aurelian_frigate" %>"
                        id="catalog-tab-<%= key %>"
                        role="tab"
                        aria-selected="<%= key == "aurelian_frigate" %>"
                        aria-controls="catalog-panel-<%= key %>"
                        tabindex="<%= key == "aurelian_frigate" ? 0 : -1 %>"
                        data-catalog-ship="<%= key %>">
                  <%= image_tag "ships/tactical/#{key}.png", alt: "", aria: { hidden: true } %>
                  <span><strong><%= ship[:name].delete_prefix("#{fleet[:name].split.first} ") %></strong><small><%= ship[:size] %> hull</small></span>
                </button>
              <% end %>
            </section>
          <% end %>
        </nav>

        <div class="ship-catalog-details">
          <% ShatteredReach::GameDefinition::SHIPS.each do |key, ship| %>
            <% fleet = ShatteredReach::GameDefinition::FLEETS.fetch(ship[:fleet]) %>
            <% grouped_weapons = ship[:weapons].group_by { |weapon| [weapon[:type], weapon[:mount], weapon[:arc], weapon[:ammo]] } %>
            <% weapon_types = ship[:weapons].map { |weapon| weapon[:type] }.uniq %>
            <article id="catalog-panel-<%= key %>"
                     class="catalog-ship-detail fleet-<%= ship[:fleet] %>"
                     role="tabpanel"
                     aria-labelledby="catalog-tab-<%= key %>"
                     tabindex="0"
                     data-catalog-panel="<%= key %>"
                     <%= "hidden" unless key == "aurelian_frigate" %>>
              <header class="catalog-detail-header">
                <div>
                  <p class="eyebrow"><%= fleet[:name] %> · <%= ship[:size] %> hull</p>
                  <h3><%= ship[:name] %></h3>
                  <p data-ship-lore><%= ship[:blurb] %></p>
                </div>
                <dl class="catalog-stat-grid">
                  <div><dt>Hull</dt><dd><%= ship[:hull] %></dd></div>
                  <div><dt>Energy</dt><dd><%= ship[:energy] %></dd></div>
                  <div><dt>Forward</dt><dd><%= ship[:front_shields] %></dd></div>
                  <div><dt>Aft</dt><dd><%= ship[:aft_shields] %></dd></div>
                </dl>
              </header>

              <div class="catalog-profile-grid">
                <figure class="catalog-ship-portrait">
                  <%= image_tag "ships/tactical/#{key}.png", alt: "Top-down tactical illustration of the #{ship[:name]}" %>
                  <figcaption><span><%= ship[:size] %> class</span><strong><%= grouped_weapons.values.sum(&:length) %> weapon systems</strong></figcaption>
                </figure>

                <div class="catalog-systems">
                  <section class="catalog-turn-mode">
                    <header><h4>Turn mode</h4><span>Hexes before turning</span></header>
                    <div><span>Speed</span><b>1–4</b><b>5–8</b><b>9–12</b></div>
                    <div><span>Hexes</span><% ship_turn_modes.fetch(ship[:size]).each do |value| %><strong><%= value %></strong><% end %></div>
                  </section>

                  <section class="catalog-loadout">
                    <header><h4>Weapons manifest</h4><span><%= ship[:weapons].length %> damageable mounts</span></header>
                    <div>
                      <% grouped_weapons.each do |(type, mount, arc, ammo), weapons| %>
                        <% profile = ShatteredReach::GameDefinition::WEAPONS.fetch(type) %>
                        <article>
                          <span class="catalog-mount"><i><%= mount %></i></span>
                          <div><strong><%= profile[:label] %><%= " ×#{weapons.length}" if weapons.length > 1 %></strong><small>Arc <%= arc.join(" · ") %><%= " · #{ammo} missiles each" if ammo %></small></div>
                          <b><%= type == "missile" ? "MAG" : "#{profile[:energy]}E" %></b>
                        </article>
                      <% end %>
                    </div>
                  </section>
                </div>
              </div>

              <div class="catalog-weapon-matrices">
                <% weapon_types.each do |type| %>
                  <% weapon = ShatteredReach::GameDefinition::WEAPONS.fetch(type) %>
                  <% if type == "missile" %>
                    <section class="catalog-weapon-chart"><header><h4><%= weapon[:label] %></h4><span>Speed 24 · 2 hexes per impulse</span></header><table><tbody><tr><th>Contact</th><td>Automatic hit</td><th>Damage</th><td><%= weapon[:damage].first %></td></tr></tbody></table></section>
                  <% else %>
                    <% boundaries = weapon[:ranges] %>
                    <% ranges = ["1–#{boundaries[0]}", "#{boundaries[0] + 1}–#{boundaries[1]}", "#{boundaries[1] + 1}–#{boundaries[2]}"] %>
                    <section class="catalog-weapon-chart">
                      <header><h4><%= weapon[:label] %></h4><span><%= weapon[:energy] %> energy</span></header>
                      <table><thead><tr><th></th><th>Short</th><th>Medium</th><th>Long</th></tr></thead><tbody>
                        <tr><th>Range</th><% ranges.each do |range| %><td><%= range %></td><% end %></tr>
                        <tr><th>To hit</th><% weapon[:to_hit].each do |hit| %><td><%= hit %>+</td><% end %></tr>
                        <tr><th>Damage</th><% weapon[:damage].each do |damage| %><td><%= damage %></td><% end %></tr>
                      </tbody></table>
                    </section>
                  <% end %>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      </div>
    </div>
  </dialog>

  <section class="setting-intro" aria-labelledby="setting-title">
    <div class="setting-heading">
      <p class="eyebrow"><%= ShatteredReach::GameDefinition::SETTING[:kicker] %></p>
      <h2 id="setting-title"><%= ShatteredReach::GameDefinition::SETTING[:title] %></h2>
    </div>
    <div class="setting-copy">
      <% ShatteredReach::GameDefinition::SETTING[:paragraphs].each do |paragraph| %><p><%= paragraph %></p><% end %>
    </div>
  </section>

  <section class="fleet-intro">
    <div><p class="eyebrow">Three powers. One frontier.</p><h2>Choose your doctrine.</h2></div>
    <% ShatteredReach::GameDefinition::FLEETS.each do |key, fleet| %>
      <article class="fleet-card <%= key %>" style="background-image: linear-gradient(0deg, rgba(11,16,39,.96), rgba(11,16,39,.1)), url('<%= asset_path("shattered_reach/#{key}-lineup.png") %>')"><h3><%= fleet[:name] %></h3><p><%= fleet[:description] %></p></article>
    <% end %>
  </section>
</main>
